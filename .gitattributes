* text=auto eol=lf
*.png binary
*.gif binary
*.zip binary
# Reviewed worked examples retain exact source, HTML and calculation bytes.
examples/autonomy/** -text whitespace=trailing-space,space-before-tab,cr-at-eol
docs/autonomy/*.html -text whitespace=trailing-space,space-before-tab,cr-at-eol
# Public desktop worked examples preserve source-input and generated bytes.
examples/autonomous-desktop/** -text whitespace=trailing-space,space-before-tab,cr-at-eol,-blank-at-eof
docs/desktop/*.html -text whitespace=trailing-space,space-before-tab,cr-at-eol,-blank-at-eof
# Regression records retain the reviewed source-input and computed bytes.
examples/regression/** -text whitespace=trailing-space,space-before-tab,cr-at-eol,-blank-at-eof
docs/regression/*.html -text whitespace=trailing-space,space-before-tab,cr-at-eol,-blank-at-eof
docs/review-rubric.md -text whitespace=trailing-space,space-before-tab,cr-at-eol
docs/review-protocol.md -text whitespace=trailing-space,space-before-tab,cr-at-eol
